      "provider": "local",
      "model": "qwen3.5-9b",
      "base_url": "http://127.0.0.1:8080/v1/chat/completions",
      "api_key_path": "D:/_Desktop/api_key.txt",
      "max_output_tokens": 12288,
      "context_window": 20000,
      "temperature": 0.0,
      "timeout_seconds": 360,
      "batch_size": 1
    }
  },
  "agent_search_query": {
    "agent_dir": "search_query",
