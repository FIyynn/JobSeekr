# DEPRECATED — JobHuntrr no longer uses .env
#
# All account settings are stored in:
#   data/profile_settings.json
#
# Edit via GUI: Profile Settings → Account & credentials → Save all settings
#
# Template: data/profile_settings.template.json
#
# Keys (inside profile_settings.json → "env"):
#   STORAGE_BACKEND=local
#   AUTO_ENRICH_PROFILE=1
#   PROFILE_DUAL_LAYER=1
#   INTERACTIVE_APPLY=1
#   APPLICANT_EMAIL=
#   APPLICANT_PHONE=
#   LINKEDIN_EMAIL=
#   LINKEDIN_PASSWORD=
#   NOTION_TOKEN=          (optional)
#   NOTION_DATABASE_ID=   (optional)
